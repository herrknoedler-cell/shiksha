# =============================================================
# SHIKSHA Engine — Environment
# Copy to .env and fill in. NEVER commit .env to git.
# =============================================================

# ---- App ----
APP_ENV=development               # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info

# ---- Database ----
DATABASE_URL=postgresql+psycopg2://shiksha:CHANGE_ME@localhost:5432/shiksha
DB_SCHEMA=shiksha_core

# ---- JWT ----
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_LIFETIME_DAYS=30

# ---- WebAuthn ----
WEBAUTHN_RP_ID=shiksha.world      # In dev: localhost
WEBAUTHN_RP_NAME=SHIKSHA
WEBAUTHN_ORIGIN=https://shiksha.world  # In dev: http://localhost:8000

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=300

# ---- CORS ----
ALLOWED_ORIGINS=https://shiksha.world,https://dev.shiksha.world,https://kita.shiksha.world

# ---- Rate Limit ----
RATE_LIMIT_PER_OPERATOR_PER_DAY=200

# ---- Editions ----
EDITIONS_DIR=editions             # Pfad zu den yaml-Configs

# ---- Email (Notausgang OTP) — Phase 2, jetzt nur Platzhalter ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=shiksha@shiksha.world
