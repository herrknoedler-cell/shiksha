# SHIKSHA · Required Environment Variables
#
# Lokale Entwicklung: kopier diese Datei nach .env (im Repo-Root oder im
# Verzeichnis, von dem der Python-Prozess startet), trag echte Werte ein.
# server/database.py lädt .env automatisch via python-dotenv (falls
# installiert: `pip install python-dotenv`).
#
# Production: systemd-Drop-Ins unter
#   /etc/systemd/system/shiksha.service.d/<name>.conf
# setzen die Variablen direkt im Service-Environment. .env wird dort
# nicht gelesen (gibt's nicht).
#
# .env ist gitignored (siehe .gitignore). .env.example NICHT — diese
# Vorlage gehört ins Repo als kanonische Liste der erwarteten ENVs.

# === Required ============================================================

# PostgreSQL-Verbindung. Format:
#   postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://shiksha:CHANGEME@localhost/shiksha

# === Optional (je nach Modul) ============================================

# Anthropic Claude API für Marketing-Site-Generation und KITA-AI-Endpoints.
# Ohne diesen Key liefern /marketing/generate und /kita/ai/* einen 503.
ANTHROPIC_API_KEY=

# VAPID-Keys für Web-Push (Pädagogen- und Eltern-PWA-Notifications).
# Erst-Setup auf Server: deploy/scripts/vapid_setup.sh
# Lokal nur nötig, wenn Du Push-Endpoints testest.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:thomas@shiksha.tun.zone

# === Mail (für KITA-Notifications-Modul) =================================
# Optional. Wenn nicht gesetzt: Mail-Versand fällt zurück auf einen Log-
# Eintrag, kein echter SMTP-Call.
KITA_MAIL_FROM=shiksha@tun.zone
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
KITA_LEITUNG_EMAIL=

# === Legacy-Migration ====================================================
# Nur für scripts/migrate-kita-legacy/migrate_sqlite_to_pg.py.
# Pfad zur SQLite-DB der alten KITA-App auf dem Server. Default-Wert
# stimmt für Production; lokal anpassen, falls die Datei woanders liegt.
LEGACY_SQLITE_PATH=/opt/shiksha-kita/shiksha_kita.db
